{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dashboard server (8765)",
      "type": "shell",
      "command": "if lsof -nP -iTCP:8765 -sTCP:LISTEN >/dev/null 2>&1; then echo 'dashboard server on http://127.0.0.1:8765/'; echo '(already running)'; exit 0; fi; exec env PORT=8765 python3 serve.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "8765"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dashboard-server",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "dashboard server on"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    }
  ]
}
